#!/bin/bash

user="cjl"
host="100.88.54.3"
password="cjldcd"
port="1049"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 检查是否安装了 sshpass
check_sshpass() {
    if ! command -v sshpass &> /dev/null; then
        echo -e "${RED}错误: 未安装 sshpass${NC}"
        echo -e "${YELLOW}请先安装 sshpass:${NC}"
        echo "  Ubuntu/Debian: sudo apt-get install sshpass"
        echo "  CentOS/RHEL: sudo yum install sshpass"
        echo "  macOS: brew install sshpass"
        exit 1
    fi
}

# 获取密码
get_password() {
    if [ -z "$password" ]; then
        echo -e "${BLUE}请输入SSH密码:${NC}"
        read -s password
        echo
    fi
}

# 显示命令并执行
execute_command() {
    local cmd="$1"
    local description="$2"
    
    echo -e "${GREEN}执行命令:${NC} $cmd"
    echo -e "${BLUE}描述:${NC} $description"
    echo "----------------------------------------"
    
    eval "$cmd"
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}✓ 命令执行成功${NC}"
    else
        echo -e "${RED}✗ 命令执行失败 (退出码: $exit_code)${NC}"
    fi
    echo "----------------------------------------"
    return $exit_code
}

# 检查参数数量并执行相应操作
main() {
    check_sshpass
    get_password
    
    if [ "$#" -eq 0 ]; then
        # SSH 登录
        local ssh_cmd="sshpass -p '$password' ssh -o StrictHostKeyChecking=no"
        if [ -n "$port" ]; then
            ssh_cmd="$ssh_cmd -p $port"
        fi
        ssh_cmd="$ssh_cmd '$user@$host'"
        
        execute_command "$ssh_cmd" "SSH 登录到远程服务器"
        
    elif [ "$#" -eq 1 ]; then
        # 上传文件
        file="$1"
        if [ ! -e "$file" ]; then
            echo -e "${RED}错误: 文件或目录 '$file' 不存在${NC}"
            exit 1
        fi
        
        local scp_cmd="sshpass -p '$password' scp -r"
        if [ -n "$port" ]; then
            scp_cmd="$scp_cmd -P $port"
        fi
        scp_cmd="$scp_cmd '$file' '$user@$host:~/'"
        execute_command "$scp_cmd" "上传文件 '$file' 到 $user 远程服务器 ~/"

    elif [ "$#" -eq 2 ]; then
        # 下载文件
        remote_path="$1"
        local_path="$2"
        
        local scp_cmd="sshpass -p '$password' scp -r"
        if [ -n "$port" ]; then
            scp_cmd="$scp_cmd -P $port"
        fi
        scp_cmd="$scp_cmd '$user@$host:$remote_path' '$local_path'"
        execute_command "$scp_cmd" "从远程服务器下载 '$remote_path' 到本地 '$local_path'"
        
    else
        echo -e "${YELLOW}用法:${NC}"
        echo "  $0                         # SSH 登录"
        echo "  $0 <local_file>            # 上传到远程 ~/"
        echo "  $0 <remote_path> <local>   # 从远程下载文件"
        echo ""
        echo -e "${BLUE}示例:${NC}"
        echo "  $0                                    # 登录到远程服务器"
        echo "  $0 /path/to/local/file.txt           # 上传文件"
        echo "  $0 /remote/path/file.txt ./local/    # 下载文件"
        exit 1
    fi
}

# 运行主函数
main "$@"
